# syntax=docker/dockerfile:1.7-labs

FROM ubuntu:24.04 AS open3d-builder
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential cmake ninja-build python3 curl ca-certificates sudo \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/src
RUN git clone -b v0.19.0 https://github.com/isl-org/Open3D.git \
 && cd Open3D \
 && yes | bash util/install_deps_ubuntu.sh \
 && mkdir build && cd build \
 && cmake -G Ninja -DBUILD_WEBRTC=OFF -DCMAKE_INSTALL_PREFIX=/opt/open3d-install .. \
 && cmake --build . --target install

FROM openvino/ubuntu24_runtime:2025.3.0 AS ort-builder
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential cmake ninja-build python3 python3-pip \
    ca-certificates curl protobuf-compiler libprotobuf-dev zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/src
RUN git clone --depth 1 -b v1.22.2 https://github.com/microsoft/onnxruntime.git \
 && bash -lc 'set -euxo pipefail; set +u; source /opt/intel/openvino/setupvars.sh; set -u; \
    cd /opt/src/onnxruntime; \
    ./build.sh \
      --allow_running_as_root \
      --use_dnnl \
      --use_openvino GPU \
      --parallel \
      --skip_tests \
      --update \
      --build \
      --cmake_generator Ninja \
      --compile_no_warning_as_error \
      --config Release \
      --build_shared_lib; \
    cmake --install build/Linux/Release --prefix /usr/local;' \
 && rm -rf /opt/src/onnxruntime

FROM ros:jazzy-ros-base AS base
USER root
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=jazzy
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg2 lsb-release software-properties-common \
    git build-essential cmake ninja-build \
    clang-format clang-tidy \
    sudo iproute2 iputils-ping wget htop vim tmux traceroute \
    ocl-icd-libopencl1 clinfo \
    libopencv-dev libopencv-contrib-dev \
    libglfw3-dev libglew-dev libeigen3-dev \
    libopenblas-dev liblapack-dev protobuf-compiler libprotobuf-dev zlib1g-dev libjpeg-dev libpng-dev \
    ros-$ROS_DISTRO-ros2-control ros-$ROS_DISTRO-ros2-controllers ros-$ROS_DISTRO-ur \
    ros-$ROS_DISTRO-moveit ros-$ROS_DISTRO-tf2-ros ros-$ROS_DISTRO-tf2-eigen ros-$ROS_DISTRO-tf2-geometry-msgs \
    ros-$ROS_DISTRO-controller-manager-msgs ros-$ROS_DISTRO-ur-dashboard-msgs \
    ros-$ROS_DISTRO-launch-testing-ament-cmake \
    libc++-dev libc++abi-dev libgmock-dev python3-empy python3-yaml \
  && rm -rf /var/lib/apt/lists/*

COPY --from=open3d-builder /opt/open3d-install/ /usr/local/
COPY --from=ort-builder /usr/local/ /usr/local/
COPY --from=ort-builder /opt/intel /opt/intel
COPY --from=ort-builder /usr/lib/x86_64-linux-gnu/libze_* /usr/lib/x86_64-linux-gnu/
COPY --from=ort-builder /usr/lib/x86_64-linux-gnu/libOpenCL.so* /usr/lib/x86_64-linux-gnu/
COPY --from=ort-builder /usr/lib/x86_64-linux-gnu/libigc* /usr/lib/x86_64-linux-gnu/
COPY --from=ort-builder /usr/lib/x86_64-linux-gnu/libocloc* /usr/lib/x86_64-linux-gnu/
COPY --from=ort-builder /etc/OpenCL /etc/OpenCL

ENV onnxruntime_DIR=/usr/local/lib/cmake/onnxruntime \
    CMAKE_PREFIX_PATH=/usr/local \
    LD_LIBRARY_PATH=/usr/local/lib:/opt/intel/openvino/runtime/lib/intel64:/opt/intel/openvino/runtime/3rdparty/tbb/lib
RUN ldconfig

RUN id -u ubuntu >/dev/null 2>&1 || useradd -m -d /workspace -s /bin/bash ubuntu \
 && passwd -d ubuntu || true && usermod -aG sudo ubuntu \
 && echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu && chmod 0440 /etc/sudoers.d/ubuntu

FROM base AS app-builder

USER ubuntu
WORKDIR /workspace/source
COPY --chown=ubuntu:ubuntu \
     --exclude=.git \
     --exclude=.github \
     --exclude=.cache \
     --exclude=.ruff_cache \
     --exclude=**/data \
     --exclude=**/build \
     --exclude=**/install \
     --exclude=**/log \
     --exclude=cad \
     --exclude=result \
     --exclude=VI \
     --exclude=core* \
     . /workspace/source

RUN bash -lc 'source /opt/ros/$ROS_DISTRO/setup.bash; \
    colcon build --merge-install --install-base /workspace/app' \
    && rm -rf /workspace/source
COPY --chown=ubuntu:ubuntu launch.sh /workspace/app/launch.sh

FROM base AS run

USER ubuntu
WORKDIR /workspace/app
COPY --from=app-builder --chown=ubuntu:ubuntu /workspace/app /workspace/app
RUN chmod +x /workspace/app/launch.sh
USER ubuntu

CMD ["/workspace/app/launch.sh"]
